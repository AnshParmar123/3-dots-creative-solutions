---
import type { WorkItem } from "../data/site";

interface Props {
  items?: WorkItem[];
  filters?: boolean;
  eager?: number;
}

const { items = [], filters = false, eager = 0 } = Astro.props;

const categories = [
  { slug: "logo", label: "Logo" },
  { slug: "packaging", label: "Packaging" },
  { slug: "otc", label: "OTC" },
  { slug: "health-care", label: "Health care" },
];
---

{filters && (
  <div class="filters" data-filters>
    <button class="filter" type="button" data-filter="all" aria-pressed="true">
      Everything <b>{items.length}</b>
    </button>
    {categories.map((category) => (
      <button class="filter" type="button" data-filter={category.slug} aria-pressed="false">
        {category.label} <b>{items.filter((item) => item.category === category.slug).length}</b>
      </button>
    ))}
  </div>
)}

<div class="grid" data-grid>
  {items.map((item, index) => (
    <button
      class="tile"
      type="button"
      data-category={item.category}
      data-src={item.src}
      data-caption={item.alt}
      data-w={item.w}
      data-h={item.h}
      aria-label={`View larger: ${item.alt}`}
    >
      <img
        src={item.src}
        alt={item.alt}
        width={item.w}
        height={item.h}
        loading={index < eager ? "eager" : "lazy"}
        decoding="async"
      />
      <span class="tile__cap"><span>{item.alt}</span></span>
    </button>
  ))}
</div>

{/* Filtering is handled by Motion.astro so it can animate between states. */}
